# Configurações do Banco de Dados Oracle
# Copie este arquivo para .env e preencha com suas credenciais

# Conexão Oracle via VPN PUC
ORACLE_USER=seu_usuario
ORACLE_PASSWORD=sua_senha
ORACLE_HOST=172.16.12.14
ORACLE_PORT=1521
ORACLE_SID=XE

# Porta do servidor Node.js
PORT=5000

# Configurações de E-mail (para recuperação de senha)
# Para Gmail: use smtp.gmail.com, porta 587
# IMPORTANTE: No Gmail, habilite "Senhas de app" em Configurações > Segurança
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=seu_email@gmail.com
EMAIL_PASS=sua_senha_de_app

# URL base da aplicação (para links de recuperação)
BASE_URL=http://localhost:5000
